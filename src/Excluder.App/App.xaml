<Application x:Class="Excluder.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#60519B" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F1F3" /></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F1F1F3"/><Setter Property="Background" Value="#202026"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C2B2FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#92929D"/>
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Padding" Value="0,9"/>
    </Style>
    <Style x:Key="DestructiveAction" TargetType="Button" BasedOn="{StaticResource TextAction}">
      <Setter Property="Foreground" Value="#B59C9F"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#CC8E96"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#92929D"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center"/>
          <Border x:Name="Track" Grid.Column="1" Width="30" Height="17" CornerRadius="8" Background="#34343D">
            <Ellipse x:Name="Thumb" Width="11" Height="11" Fill="#F1F1F3" HorizontalAlignment="Left" Margin="3,0"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#60519B"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#C2B2FF"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PurpleScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="7"/>
      <Setter Property="MinWidth" Value="7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Margin" Value="5,0,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent" Width="{TemplateBinding Width}">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" IsTabStop="False"/>
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb MinHeight="24">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbSurface" Background="#60519B" CornerRadius="3" Opacity="0.82"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#7362B2"/><Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/></Trigger>
                      <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#8371C5"/><Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" IsTabStop="False"/>
            </Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
