<Window x:Class="Excluder.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="143 OW Switch" Width="360" Height="398" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
 <Border CornerRadius="14" Background="#111113" BorderBrush="#29292F" BorderThickness="1" Padding="22,15,22,18">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="DragTitle">
    <TextBlock Text="143" FontWeight="Bold" FontSize="21" VerticalAlignment="Top"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
     <Button Content="—" AutomationProperties.Name="Minimize to tray" Click="HideWindow" Background="Transparent" Padding="9,3"/>
     <Button Content="×" AutomationProperties.Name="Close to tray" Click="HideWindow" Background="Transparent" Padding="9,3" FontSize="16"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <StackPanel x:Name="Home">
     <TextBlock Text="OVERWATCH / FINLAND" FontSize="10" Foreground="#92929D" Margin="0,7,0,16"/>
     <Border Background="#202026" CornerRadius="10" Padding="4">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button x:Name="SoloButton" Content="BLOCK" Click="SelectSolo" Height="39" FontWeight="SemiBold" Background="Transparent"/>
       <Button x:Name="PartyButton" Grid.Column="1" Content="UNBLOCK" Click="SelectParty" Height="39" FontWeight="SemiBold" Background="Transparent"/>
      </Grid>
     </Border>
     <Border Background="#18181C" CornerRadius="11" Margin="0,11,0,11" Padding="14,10">
      <StackPanel HorizontalAlignment="Center">
       <TextBlock Text="GEN1 / FINLAND" HorizontalAlignment="Center" Foreground="#92929D" FontSize="10"/>
       <TextBlock x:Name="Status" Text="CHECKING" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
       <TextBlock x:Name="Subtitle" Text="Reading saved mode" Foreground="#92929D" HorizontalAlignment="Center" FontSize="11"/>
       <TextBlock x:Name="Health" Text="" Foreground="#B6A4F0" HorizontalAlignment="Center" FontSize="10" Margin="0,7,0,0"/>
      </StackPanel>
     </Border>
     <Border Height="1" Background="#29292F"/>
     <CheckBox x:Name="StartupToggle" Content="Run on startup" Click="StartupChanged" Margin="0,10,0,5"/>
     <CheckBox x:Name="MinimizedToggle" Content="Start minimized" Click="MinimizedChanged" Margin="0,5"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="Settings  ›" Style="{StaticResource TextAction}" Padding="0,8" Click="OpenSettings"/>
      <Button x:Name="HomeUpdate" Grid.Column="1" Visibility="Collapsed" Background="Transparent" Padding="0,9" Foreground="#B6A4F0" Click="InstallUpdate" FontSize="10"/>
     </Grid>
     <Button Click="OpenDiscord" Style="{StaticResource DiscordAction}" ToolTip="Join 143 Aim Club on Discord">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Viewbox Width="14" Height="14" Margin="0,0,6,0">
